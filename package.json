{
  "name": "almatriz-site",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio estatico Almatriz (escuela-almatriz.com) con Tailwind build local",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./site/assets/tailwind.css --minify",
